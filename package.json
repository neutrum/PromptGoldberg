{
  "name": "prompt-goldberg",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @pg/web",
    "dev:server": "npm run dev -w @pg/server",
    "build": "npm run build -w @pg/web",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "pg": "npm run -s pg -w @pg/cli --",
    "recipes": "npm run -s pg -w @pg/cli -- recipes --jobs 4"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
