# LLM backend: "api" (needs ANTHROPIC_API_KEY) or "cli" (dev only: uses your local Claude Code login).
# Default: api when ANTHROPIC_API_KEY is set, otherwise cli unless NODE_ENV=production.
LLM_BACKEND=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# How much Claude thinks before answering: low (default, fastest) | medium | high | xhigh | max.
CLAUDE_EFFORT=low
# CLAUDE_CLI=claude
# CLAUDE_CLI_TIMEOUT_MS=180000
PORT=8787
# Model for /api/coach rephrasing (short replies; falls back to rule-based tips after 8 s or on error).
CLAUDE_COACH_MODEL=claude-sonnet-5

# Storage for the community gallery (gallery.json) and the /api/level response cache (cache/).
# Default: <repo>/data. Relative paths resolve against the server process cwd (apps/server under npm -w).
# DATA_DIR=
# Set to 1 behind a reverse proxy so rate limits see the client IP (X-Forwarded-For).
TRUST_PROXY=

# Hosted-demo protection. Per-IP limits apply to /api/level, /api/edit and /api/design.
RATE_LIMIT_PER_MIN=6
RATE_LIMIT_PER_DAY=40
# Global LLM calls per UTC day across all users (a level can take up to ~6 calls).
DAILY_LLM_CALL_CAP=1000
# Hosted demo: about 2 calls per AI level. Use 100 while testing, 300 for judging.
MAX_PROMPT_CHARS=500
MAX_INSTRUCTION_CHARS=300
# Coach requests per IP per minute that may use the LLM (beyond: rule-based tip).
COACH_RATE_LIMIT_PER_MIN=12
PUBLISH_RATE_LIMIT_PER_MIN=4
PUBLISH_RATE_LIMIT_PER_DAY=30
RESULT_RATE_LIMIT_PER_MIN=30
GALLERY_MAX_ENTRIES=1000

# Repair loop: designs per level, optimizer evaluations and wall time per design.
LEVEL_MAX_ATTEMPTS=3
SOLVE_BUDGET=600
SOLVE_TIME_MS=12000
LEVEL_DEADLINE_MS=150000
# auto (worker thread, falls back to in-thread chunks) | worker | inline
SOLVER_MODE=auto
